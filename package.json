{
  "name": "drep-groups",
  "version": "0.1.0",
  "description": "Reference library for the DRep Groups CIP draft: codec, validation and state machine",
  "keywords": [
    "cardano",
    "drep",
    "governance",
    "cip",
    "metadata",
    "conway"
  ],
  "author": "Tommy (https://github.com/katomm)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/katomm/cardano-drep-groups.git"
  },
  "homepage": "https://github.com/katomm/cardano-drep-groups#readme",
  "bugs": {
    "url": "https://github.com/katomm/cardano-drep-groups/issues"
  },
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vectors/vectors.json": "./vectors/vectors.json"
  },
  "files": [
    "dist",
    "vectors/vectors.json",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:devnet": "vitest run --config vitest.devnet.config.ts",
    "vectors": "UPDATE_VECTORS=1 vitest run test/vectors.test.ts",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@noble/hashes": "^2.3.0",
    "bech32": "^2.0.0"
  },
  "devDependencies": {
    "@evolution-sdk/devnet": "3.0.21",
    "@evolution-sdk/evolution": "0.6.0",
    "@types/node": "^26.4.1",
    "cborg": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
