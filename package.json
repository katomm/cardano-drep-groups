{
  "name": "drep-groups",
  "version": "0.1.0",
  "description": "Reference library for the DRep Groups CIP draft: codec, validation and state machine",
  "type": "module",
  "license": "Apache-2.0",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist", "vectors/vectors.json"],
