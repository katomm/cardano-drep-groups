{
  "name": "drep-groups",
  "version": "0.1.0",
  "description": "Reference library for the DRep Groups CIP draft: codec, validation and state machine",
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vectors/vectors.json": "./vectors/vectors.json"
  },
  "files": [
    "dist",
    "vectors/vectors.json"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "vectors": "UPDATE_VECTORS=1 vitest run test/vectors.test.ts"
  },
  "dependencies": {
    "@noble/hashes": "^2.3.0",
    "bech32": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "cborg": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
