  },
  "dependencies": { "@noble/hashes": "^2.3.0", "bech32": "^2.0.0", "cborg": "^6.1.2" },
  "devDependencies": { "@types/node": "^26.4.1", "typescript": "^6.0.3", "vitest": "^4.1.10" }
}
